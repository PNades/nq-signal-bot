{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --quiet python -m nqbot.tool_guard",
            "timeout": 30,
            "statusMessage": "Checking the command against rules 14 (e) and 15"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --quiet python -m nqbot.repo_guard --worktree",
            "timeout": 60,
            "statusMessage": "Checking CLAUDE.md size and tracked file sizes"
          }
        ]
      }
    ]
  }
}
